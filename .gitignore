# ─── Files that CANNOT go to GitHub (>100 MB hard limit) ───────
# Raw EEG recordings are 98-122 MB each — ALL exceed GitHub's limit
SEED-VIG/Raw_Data/*.mat

# ─── SEED-VIG data (incl. PERCLOS labels): obtained from the lab on request — NEVER publish ───
SEED-VIG/
processed_data/EEG_Feature_2Hz/

# Processed datasets (0.6–1.2 GB each) — too big, and derived from SEED-VIG
processed_data/*.npz

# Per-fold probability caches (contain per-epoch labels; regenerate with
# python -m evaluation.postprocess)
processed_data/**/fold_probs.npz

# Model set / log of a training run still in progress
processed_data/saved_models_v4/
train_v4_log*.txt

# ─── Python cache & virtual env (never push these) ──────────────
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
env/
.venv/

# ─── System files ───────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Jupyter / IDE ──────────────────────────────────────────────
.ipynb_checkpoints/